bin/
obj/
node_modules/
dist/
.vite/
.DS_Store
# Runtime artifacts only — NOT the whole directory. backend/Data/ holds source
# (SiteCatalog.cs, PriceDb.cs) alongside generated files, and on a case-insensitive
# filesystem a `backend/data/` rule silently swallows new source files too.
backend/data/alerts.json
backend/data/outbox/
backend/data/prices.db*
frontend/adopt-tab.png

# Local dev config. Untracked on purpose: this file used to be tracked while its own
# comment said "do not commit real keys", so following that advice would have committed
# one. Secrets belong in `dotnet user-secrets` (the project already has a UserSecretsId);
# this file is only for non-secret local overrides.
backend/appsettings.Development.json
backend/appsettings.*.Local.json

# e2e screenshot artifacts (e2e-smoke.mjs writes here when SCRATCH is unset)
adopt-tab.png
*-tab.png

# scratch debug scripts (write these to the scratchpad, not the repo)
*.tmp.mjs
